# This .gitignore should be placed at the root of your Unity project directory
# https://github.com/github/gitignore/blob/main/Unity.gitignore

/[Ll]ibrary/
/[Tt]emps/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Uu]serSettings/

# Packages can be ignored if you are not using UPM packages or want them to be pulled automatically
/[Pp]ackages/cache/
/[Pp]ackages/temp/

# Asset meta data should usually be tracked, but sometimes people prefer to ignore them (not recommended)
# !/[Aa]ssets/**/*.meta

# Autogenerated Visual Studio / IDE files
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Generated Metal/Shader cache
*[Rr]ootRA/
*[Bb]uild/
*[Bb]uilds/
*[Ll]inux/
*[Mm]acOSX/
*[Ww]in32/
*[Ww]in64/
*[Ll]inux64/

# Autogenerated C#/C++ files
*.h
*.cpp

# Profiler, Raytracing, and Memory Capture caches
*.raw
*.cap

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/